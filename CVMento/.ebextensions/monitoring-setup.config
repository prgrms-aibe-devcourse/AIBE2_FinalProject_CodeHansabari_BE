files:
  "/opt/aws/bin/eip-associate.sh":
    mode: "000755"
    owner: root
    group: root
    content: |
      #!/bin/bash
      EIP_ALLOCATION_ID="eipalloc-0a3141de40efc714b"

      INSTANCE_ID=$(curl -s http://169.254.169.254/latest/meta-data/instance-id)

      aws ec2 associate-address \
        --instance-id $INSTANCE_ID \
        --allocation-id $EIP_ALLOCATION_ID \
        --region ap-northeast-2

  "/opt/aws/bin/setup-swap.sh":
    mode: "000755"
    owner: root
    group: root
    content: |
      #!/bin/bash
      LOG_FILE="/var/log/swap-setup.log"
      exec > >(tee -a $LOG_FILE) 2>&1

      echo "=== Swap 메모리 설정 시작: $(date) ==="

      if [ ! -f /swapfile ]; then
        echo "1GB swap 파일 생성 중..."
        dd if=/dev/zero of=/swapfile bs=1M count=1024
        chmod 600 /swapfile
        mkswap /swapfile
      fi

      swapon /swapfile
      if ! grep -q "/swapfile" /etc/fstab; then
        echo '/swapfile none swap sw 0 0' >> /etc/fstab
      fi

      if ! grep -q "vm.swappiness=10" /etc/sysctl.conf; then
        echo 'vm.swappiness=10' >> /etc/sysctl.conf
      fi
      sysctl vm.swappiness=10

      echo "=== Swap 설정 완료: $(date) ==="
      free -h

  "/opt/aws/bin/install-grafana-agent.sh":
    mode: "000755"
    owner: root
    group: root
    content: |
      #!/bin/bash
      LOG_FILE="/var/log/grafana-agent-install.log"
      exec > >(tee -a $LOG_FILE) 2>&1

      echo "=== Grafana Agent 설치 시작: $(date) ==="

      if command -v grafana-agent &> /dev/null; then
        echo "이미 설치됨"
        grafana-agent --version
        exit 0
      fi

      echo "네트워크 연결 확인 중..."
      for i in {1..20}; do
        if ping -c 1 github.com &> /dev/null; then
          echo "네트워크 연결 확인됨"
          break
        fi
        echo "네트워크 대기 중... ($i/20)"
        sleep 10
      done

      dnf update -y
      dnf install -y wget unzip net-tools procps-ng

      cd /tmp
      AGENT_VERSION="v0.38.1"
      wget -O grafana-agent.zip "https://github.com/grafana/agent/releases/download/${AGENT_VERSION}/grafana-agent-linux-amd64.zip"

      if [ $? -eq 0 ]; then
        unzip -o grafana-agent.zip
        chmod +x grafana-agent-linux-amd64
        mv grafana-agent-linux-amd64 /usr/local/bin/grafana-agent

        useradd --system --no-create-home --shell /bin/false grafana || true
        mkdir -p /etc/grafana-agent /var/lib/grafana-agent /var/log/grafana-agent
        chown -R grafana:grafana /var/lib/grafana-agent /var/log/grafana-agent

        echo "=== Grafana Agent 설치 완료 ==="
        grafana-agent --version
      else
        echo "ERROR: 다운로드 실패"
        exit 1
      fi

  "/opt/aws/bin/start-grafana-agent.sh":
    mode: "000755"
    owner: root
    group: root
    content: |
      #!/bin/bash
      LOG_FILE="/var/log/grafana-agent-start.log"
      exec > >(tee -a $LOG_FILE) 2>&1

      echo "=== Grafana Agent 시작: $(date) ==="

      echo "Spring Boot 대기 중..."
      for i in {1..60}; do
        if curl -s http://localhost:8080/actuator/health > /dev/null 2>&1; then
          echo "Spring Boot 준비됨"
          break
        fi
        echo "Spring Boot 대기 중... ($i/60)"
        sleep 5
      done

      echo "환경변수 확인:"
      echo "GRAFANA_PUSH_URL: ${GRAFANA_PUSH_URL:0:30}..."
      echo "GRAFANA_USERNAME: ${GRAFANA_USERNAME}"

      if [ -z "$GRAFANA_PUSH_URL" ] || [ -z "$GRAFANA_USERNAME" ] || [ -z "$GRAFANA_PASSWORD" ]; then
        echo "ERROR: Grafana 환경변수가 설정되지 않았습니다"
        exit 1
      fi

      cat > /etc/grafana-agent/agent.yml << EOF
      server:
        log_level: info
        http_listen_port: 12345

      metrics:
        global:
          scrape_interval: 30s
          external_labels:
            environment: production
            service: cvmento
        configs:
          - name: cvmento-production
            scrape_configs:
              - job_name: 'spring-boot-app'
                static_configs:
                  - targets: ['localhost:8080']
                metrics_path: '/actuator/prometheus'
                scrape_interval: 30s

              - job_name: 'grafana-agent'
                static_configs:
                  - targets: ['localhost:12345']
                metrics_path: '/metrics'
                scrape_interval: 30s

            remote_write:
              - url: ${GRAFANA_PUSH_URL}
                basic_auth:
                  username: ${GRAFANA_USERNAME}
                  password: ${GRAFANA_PASSWORD}
      EOF

      chown grafana:grafana /etc/grafana-agent/agent.yml
      chmod 640 /etc/grafana-agent/agent.yml

      cat > /etc/systemd/system/grafana-agent.service << 'EOF'
      [Unit]
      Description=Grafana Agent
      After=network-online.target
      Wants=network-online.target

      [Service]
      Type=simple
      User=grafana
      Group=grafana
      ExecStart=/usr/local/bin/grafana-agent --config.file=/etc/grafana-agent/agent.yml --config.expand-env --server.http.address=0.0.0.0:12345
      Restart=always
      RestartSec=5
      WorkingDirectory=/var/lib/grafana-agent

      [Install]
      WantedBy=multi-user.target
      EOF

      systemctl daemon-reload
      pkill -f grafana-agent || true
      systemctl stop grafana-agent || true
      sleep 3
      systemctl enable grafana-agent
      systemctl start grafana-agent

      echo "=== Grafana Agent 시작 완료: $(date) ==="
      systemctl status grafana-agent --no-pager

commands:
  01_associate_eip:
    command: "/opt/aws/bin/eip-associate.sh"
    ignoreErrors: true
  02_setup_swap:
    command: "/opt/aws/bin/setup-swap.sh"
    ignoreErrors: true
  03_install_grafana_agent:
    command: "/opt/aws/bin/install-grafana-agent.sh"
    ignoreErrors: true
  04_start_grafana_agent:
    command: "/opt/aws/bin/start-grafana-agent.sh"
    ignoreErrors: false